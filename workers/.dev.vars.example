# Copy to .dev.vars for `wrangler dev`. .dev.vars is gitignored.
# Names only: never put real values in this file. In production set each one
# with `wrangler secret put <NAME>`.

# Google OAuth client, type "Web application". Authorized redirect URIs:
# http://localhost:8788/callback (dev) and https://<worker host>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in. Empty rejects everyone.
ALLOWED_GOOGLE_EMAIL=
