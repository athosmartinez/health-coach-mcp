# Copy to .dev.vars for `wrangler dev`. .dev.vars is gitignored.
# This phase reads none of these. They are the names the OAuth phase will use
# (Google sign-in on the authorization server, plus the cookie key for
# @cloudflare/workers-oauth-provider). Leave them unset until then.
# Do not put real secrets in this file.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# COOKIE_ENCRYPTION_KEY=
# HOSTED_DOMAIN=
