# `agents` declares many optional peers (AI SDK, React, and others). npm 10
# auto-installs that graph and then crashes in arborist (`edgesOut`).
# The peers this Worker needs are direct dependencies. Do not auto-install the rest.
# This setting also hides that the required peer @modelcontextprotocol/client
# is not installed. Import only from `agents/mcp/server` (it also exports
# getMcpAuthContext); `agents/mcp` needs that client and the v1 SDK, and the
# bundle fails to resolve them.
legacy-peer-deps=true
