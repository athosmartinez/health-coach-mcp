{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-coach-mcp",
  "main": "src/index.ts",
  // The newest date the pinned workerd (wrangler dev, tests) supports, so that
  // tests and deploy run the same date. Move it together with wrangler.
  "compatibility_date": "2026-11-13",
  // agents/mcp uses AsyncLocalStorage. global_fetch_strictly_public keeps
  // outbound fetches (Client ID Metadata Documents, Google) off same-zone
  // routing; workers-oauth-provider advertises CIMD only with it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 8788 is the local dev port.
  "dev": {
    "port": 8788
  },
  // The IANA zone that defines a "day" (today, a note's creation day).
  // "Local" and unknown names are rejected.
  "vars": {
    "HCM_TZ": "America/Sao_Paulo"
  },
  // Workers Free allows Durable Objects only with the SQLite backend
  // (new_sqlite_classes). No KV-backed classes, containers, or other paid features.
  "durable_objects": {
    "bindings": [
      {
        "name": "COACH_STORE",
        "class_name": "CoachStore"
      }
    ]
  },
  // workers-oauth-provider keeps clients, grants and hashed MCP tokens here.
  // The Google refresh token never goes to KV: it lives in CoachStore.
  // The id is a placeholder, not a real namespace. Each deployer creates
  // their own (`npx wrangler kv namespace create OAUTH_KV`) and sets its id.
  // See workers/README.md (Setup). The zeros are only so local tests and
  // `wrangler types` have a value.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoachStore"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
